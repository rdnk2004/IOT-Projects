# Kochi Coordinates (Open-Meteo)
KOCHI_LATITUDE=9.9312
KOCHI_LONGITUDE=76.2673
KOCHI_TIMEZONE=Asia/Kolkata

# Background Ingestion Interval (in seconds - default: 300 = 5 minutes)
FETCH_INTERVAL_SECONDS=300

# Cloud Database URL Configuration
# Default (Local SQLite Cloud-ready File):
DATABASE_URL=sqlite:///kochi_weather.db

# Example Supabase / PostgreSQL Cloud Database Connection:
# DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional Supabase REST API credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
